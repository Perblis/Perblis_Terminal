{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/governance-hook.py post-tool-use",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/governance-hook.py pre-tool-use",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/governance-hook.py session-end",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/governance-hook.py session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/governance-hook.py stop",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/governance-hook.py subagent-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/governance-hook.py subagent-stop",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
