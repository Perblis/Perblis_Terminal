# ──────────────────────────────────────────────────────────────────
# Terminal monorepo .gitignore
# backend/ (Django) · portal/ (Next.js) · mobile/ (Expo RN)
# ──────────────────────────────────────────────────────────────────

# ── Python / Django ──────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.sqlite3
.env
.env.*
!.env.example
media/
staticfiles/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.log

# ── Node / pnpm ──────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.pnp.cjs

# ── Next.js (portal/) ───────────────────────────────────────────
portal/.next/
portal/.open-next/
portal/next-env.d.ts
portal/out/
portal/.vercel/
portal/.cloudflare/
portal/.wrangler/

# ── Expo / React Native (mobile/) ────────────────────────────────
mobile/.expo/
mobile/dist/
mobile/android/
mobile/ios/
mobile/*.jks
mobile/*.keystore
mobile/*.p8
mobile/*.p12
mobile/*.mobileprovision

# ── Build artefacts ──────────────────────────────────────────────
*.tsbuildinfo
.turbo/

# Generated token outputs (source of truth is packages/tokens/src/*.json;
# `pnpm build` regenerates these — consumers build before use).
packages/tokens/tokens.ts
packages/tokens/tailwind.tokens.cjs
packages/tokens/tokens.css
packages/tokens/admin.css

# ── OS / editors ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp
*.swo
