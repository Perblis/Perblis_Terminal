# Terminal — Hirer app environment (local development only).
#
# Generate the real file with:  ./scripts/setup-env.sh
# It writes mobile/.env.local from Infisical (path /mobile), falling back to
# the committed defaults in lib/api.ts. Never fill this file in and rename it.
#
# IMPORTANT — these do NOT reach devices:
#   .env / .env.local are gitignored. EAS Build uploads the project via git and
#   the OTA workflow checks out git, so both ship the *committed defaults* in
#   mobile/lib/api.ts. Changing what a released APK talks to means editing
#   lib/api.ts and merging it — not editing a dotenv file.
#
# IMPORTANT — EXPO_PUBLIC_* is public:
#   Expo inlines every EXPO_PUBLIC_* value into the JS bundle. Anyone who
#   unzips the APK can read it. Put configuration here; never secrets.
#   Real secrets (EXPO_TOKEN for EAS) live in Infisical and are injected per
#   command: `infisical run --env=prod --path=/mobile -- pnpm exec eas build …`
#
# Expo load precedence: .env.<mode>.local > .env.local > .env.<mode> > .env
# (`.env.local` is deliberately skipped when NODE_ENV=test, so jest is unaffected.)

# Backend API root, no trailing slash and no /api/v1 suffix.
# prod:  https://terminal-api.lab.perblis.com
# local: http://<your-LAN-IP>:8000   — NOT localhost; that resolves to the phone
EXPO_PUBLIC_API_BASE_URL=

# Supplier Portal, used for the F8 "become a supplier" hand-off and legal links.
# prod:  https://terminal.lab.perblis.com
EXPO_PUBLIC_PORTAL_URL=

# Optional. Client-side Sentry DSN (designed to be public). Unset = Sentry inert.
EXPO_PUBLIC_SENTRY_DSN=
