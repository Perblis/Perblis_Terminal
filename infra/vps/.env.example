# /opt/terminal/.env — production environment for the VPS stack (D-027).
# Export from Infisical (`perblis-terminal` project, prod env) and complete
# the VPS-specific values below. root:root 0600, never committed.
#
#   infisical export --path=<project-path> --env=prod --format=dotenv > /opt/terminal/.env
#   $EDITOR /opt/terminal/.env   # then fix the VPS-specific values
#
# Every backend variable the settings read is documented in
# backend/.env.example — this file only covers what the compose stack itself
# needs to agree on.

# ── Database (db service) ──────────────────────────────────────────────
# REQUIRED to be exactly these values — infra/vps/terminal.cron's pg_dump
# job hardcodes them.
POSTGRES_DB=terminal
POSTGRES_USER=terminal
POSTGRES_PASSWORD=__generate__   # python -c "import secrets; print(secrets.token_urlsafe(32))"

# Backend reaches Postgres over the compose network — host is the service
# name `db`, NOT localhost. Overrides whatever host the Infisical export has.
# env_file values are literal (no $-interpolation) — paste the real password.
DATABASE_URL=postgis://terminal:__same-as-POSTGRES_PASSWORD__@db:5432/terminal

# ── Hostnames (Phase 5 lab domains; product domains are a later switch) ──
ALLOWED_HOSTS=terminal-api.lab.perblis.com
CORS_ALLOWED_ORIGINS=https://terminal.lab.perblis.com
PAYMENT_RETURN_BASE_URL=https://terminal-api.lab.perblis.com

# ── Portal (server-side only; never exposed to browser JS) ─────────────
# The BFF talks to the API over the public origin so absolute media URLs and
# Paystack callbacks stay consistent.
API_BASE_URL=https://terminal-api.lab.perblis.com/api/v1
# R2_PUBLIC_BASE_URL arrives via the Infisical export (backend/.env.example).
